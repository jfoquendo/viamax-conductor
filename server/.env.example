# ==========================================
# ViaMax - Backend de pagos
# ==========================================

# Entorno activo: test | production
# La app NUNCA decide por el prefijo del token.
MP_ENV=test

# --- Credenciales de PRUEBA (sandbox) ---
MP_ACCESS_TOKEN_TEST=
MP_PUBLIC_KEY_TEST=

# --- Credenciales de PRODUCCION (dinero real) ---
MP_ACCESS_TOKEN_PROD=
MP_PUBLIC_KEY_PROD=

# --- Firebase Admin ---
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json

# --- Servidor ---
PUBLIC_BASE_URL=http://localhost:3000
PORT=3000
